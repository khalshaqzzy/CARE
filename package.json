{
  "name": "care",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.23.0 <23",
    "pnpm": ">=11.8.0 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @care/api dev",
    "dev:web-voice": "pnpm --filter @care/web-voice dev",
    "dev:web-admin": "pnpm --filter @care/web-admin dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:frontend:e2e": "playwright test",
    "test:frontend:visual": "playwright test --project=visual",
    "pwa:compat-check": "node scripts/check-pwa-compatibility.mjs",
    "test:integration": "pnpm --filter @care/api test:integration",
    "test:security": "pnpm --filter @care/api test:security",
    "test:performance": "pnpm --filter @care/api test:performance",
    "test": "pnpm test:unit",
    "openapi:generate": "pnpm --filter @care/api openapi:generate && pnpm --filter @care/contracts generate",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- apps/api/openapi.json packages/contracts/src/generated.ts",
    "db:up": "docker compose up -d postgres",
    "db:wait": "node scripts/db-wait.mjs",
    "db:verify": "docker compose exec -T postgres psql -U care -d care -c 'SELECT version();' -c 'SELECT extname FROM pg_extension WHERE extname = $$vector$$;'",
    "db:down": "docker compose down",
    "db:test:reset": "docker compose exec -T postgres psql -U care -d postgres -v ON_ERROR_STOP=1 -c 'DROP DATABASE IF EXISTS care_test WITH (FORCE);' -c 'CREATE DATABASE care_test;'",
    "db:test:migrate": "DATABASE_URL=postgresql://care:care_local@localhost:54329/care_test pnpm --filter @care/api prisma:migrate:deploy",
    "test:migration:upgrade": "node scripts/test-migration-upgrade.mjs && node scripts/test-handover-migration-upgrade.mjs && node scripts/test-contact-consent-migration-upgrade.mjs",
    "db:migrate": "pnpm --filter @care/api prisma:migrate:deploy",
    "db:generate": "pnpm --filter @care/api prisma:generate",
    "migrations:destructive-check": "node scripts/check-migrations.mjs",
    "bootstrap:admin": "pnpm --filter @care/api bootstrap:admin",
    "vapid:generate": "pnpm --filter @care/api vapid:generate",
    "seed:performance": "pnpm --filter @care/api seed:performance",
    "maintenance:reconcile": "pnpm --filter @care/api maintenance:reconcile",
    "test:openai:smoke": "pnpm --filter @care/api test:openai:smoke",
    "deployment:validate": "deploy/scripts/validate-runtime-env.sh deploy/env/runtime.staging.env.example && docker compose --env-file deploy/env/runtime.staging.env.example -f deploy/compose/docker-compose.remote.yml --profile operations config --quiet",
    "test:deployment": "bash deploy/tests/deployment-scripts.sh",
    "security:exceptions:check": "deploy/scripts/check-security-exceptions.sh .agent/securityExceptions.json",
    "security:audit": "pnpm audit --audit-level high",
    "git:diff-check": "git diff --check",
    "setup:local": "pnpm --filter @care/api setup:local",
    "local:up": "bash deploy/scripts/local-stack.sh up",
    "local:down": "bash deploy/scripts/local-stack.sh down",
    "local:status": "bash deploy/scripts/local-stack.sh status",
    "local:logs": "bash deploy/scripts/local-stack.sh logs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/jest-axe": "3.5.9",
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  CARE_ADMIN
  WORKFORCE
  UNION
}

enum AccountStatus {
  ACTIVE
  LEGACY_HANDLER
  INACTIVE
}

enum UnionSlot {
  HEAD
  OFFICER_1
  OFFICER_2
}

enum OrganizationSnapshotStatus {
  ACTIVE
  SUPERSEDED
}

enum RouteKind {
  DEPARTMENT_HEAD
  DEFAULT_DEPARTMENT
  GLOBAL_SPECIAL
  LEGACY
}

enum Area {
  KARAWANG_1
  KARAWANG_2
  KARAWANG_3
  SUNTER_1
  SUNTER_2
}

enum VoiceVisibility {
  PRIVATE
  GENERAL
}

enum GeneralVoiceCategoryStatus {
  ACTIVE
  ARCHIVED
}

enum GeneralVoiceCategoryRouteMode {
  FIXED_DEPARTMENT
  RELATED_REPORTER_DEPARTMENT
  LOCATION_OWNER_DEPARTMENT
}

enum ShopLocationStatus {
  ACTIVE
  ARCHIVED
}

// How the incident shop of a General Voice was determined at submit.
enum ShopResolutionSource {
  ALIAS
  AI
  REPORTER_CONFIRMED
  REPORTER_NOT_SHOP
  NO_MATCH
}

enum ShopConfirmation {
  SHOP
  NOT_SHOP
}

// Unit of an escalation window: working days follow the working calendar,
// calendar hours run around the clock.
enum EscalationTimeUnit {
  WORKING_DAY
  CALENDAR_HOUR
}

enum CalendarDayKind {
  HOLIDAY
  WORKDAY
}

// Transitional storage vocabulary retained for rollback/read compatibility.
// New application logic uses GeneralVoiceCategory.key.
enum RoutingCategory {
  SAFETY
  ENVIRONMENT
  FACILITY
  WORK_DIFFICULTY
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VoiceStatus {
  OPEN
  RESPONDED
  IN_PROGRESS
  CLOSED
}

enum ClosureReviewState {
  PENDING
  ACCEPTED
  REJECTED
}

enum TierLevel {
  GROUP_LEADER
  SECTION_HEAD
  MANAGER
  DIVISION
}

enum HandlerType {
  MANAGER
  ADMIN_TRIAGE
  GROUP_LEADER
  SECTION_HEAD
  UNION_HEAD
  UNION_OFFICER
}

enum ClassificationSource {
  AI
  MANUAL_FALLBACK
}

enum AttachmentPurpose {
  VOICE
  CHAT
  CLOSURE_EVIDENCE
}

enum AttachmentState {
  STAGED
  PROCESSED
  REFERENCED
  READY
  ORPHANED
}

enum ImportStatus {
  PREVIEWED
  QUEUED
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED
}

enum ImportIssueType {
  MISSING_DEPARTMENT_HEAD
  ROUTE_UNAVAILABLE
  INVALID_DEFAULT_PIC
  INVALID_GLOBAL_PIC
  UNION_HEAD_MISSING
  UNION_OFFICER_MISSING
  DEPARTMENT_14
  CATEGORY_TARGET_UNAVAILABLE
  CATEGORY_PIC_UNAVAILABLE
}

enum ImportIssueStatus {
  OPEN
  RESOLVED
  SUPERSEDED
}

enum LocationCompleteness {
  COMPLETE
  INCOMPLETE
  UNKNOWN
}

enum MessageKind {
  USER
  SYSTEM
}

enum VoiceEventType {
  SUBMITTED
  HANDOVER_COMPLETED
  ADMIN_HANDOVER_REQUESTED
  ADMIN_HANDOVER_ROUTED
  ADMIN_HANDOVER_RETURNED
  ASKED_REPORTER
  MONITORED
  RESPONDED
  TARGET_SET
  TARGET_OVERDUE
  ESCALATED
  REMINDED
  MESSAGE_SENT
  ASSIGNED
  REASSIGNED
  PROCEEDED
  CLOSED
  RATED
  REOPENED
  AUTO_ACCEPTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD_LETTER
}

enum NotificationType {
  VOICE_SUBMITTED
  HANDOVER_RECEIVED
  ADMIN_HANDOVER_RETURNED
  ASSIGNED
  MESSAGE
  STATUS_CHANGED
  TARGET_SET
  TARGET_REMINDER
  TARGET_OVERDUE
  ESCALATED
  REMINDER
  AWAY_SUBSTITUTE
  CLOSED
  RATED
  REOPENED
  CLOSURE_AUTO_ACCEPTED
  SECURITY
}

enum AdminHandoverStatus {
  PENDING
  ROUTED
  RETURNED
}

model Employee {
  id          String                   @id @default(uuid()) @db.Uuid
  noReg       String                   @unique @db.VarChar(64)
  birthDate   DateTime?                @db.Date
  name        String                   @db.VarChar(200)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  account     UserAccount?
  memberships OrganizationMembership[]
}

model UserAccount {
  id                       String                         @id @default(uuid()) @db.Uuid
  employeeId               String?                        @unique @db.Uuid
  username                 String                         @unique @db.VarChar(64)
  displayName              String                         @db.VarChar(200)
  passwordHash             String
  accountKind              AccountKind
  status                   AccountStatus                  @default(ACTIVE)
  deactivatedAt            DateTime?
  passwordChangeRequired   Boolean                        @default(true)
  version                  Int                            @default(1)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  employee                 Employee?                      @relation(fields: [employeeId], references: [id])
  unionTerms               UnionAccountTerm[]
  routeMappings            RouteMapping[]                 @relation("RouteOwner")
  legacyVoiceAccess        LegacyVoiceAccess[]
  sessions                 Session[]
  drafts                   VoiceDraft[]                   @relation("DraftReporter")
  reportedVoices           Voice[]                        @relation("VoiceReporter")
  routedVoices             Voice[]                        @relation("VoiceRouteOwner")
  handledVoices            Voice[]                        @relation("VoiceHandler")
  messages                 Message[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  auditEvents              AuditEvent[]
  importBatches            ImportBatch[]
  assignmentsMade          VoiceAssignment[]              @relation("AssignmentActor")
  assignmentsReceived      VoiceAssignment[]              @relation("AssignmentHandler")
  events                   VoiceEvent[]
  closureCycles            ClosureCycle[]
  ratings                  Rating[]
  aiConfigurationsUpdated  AiProviderConfiguration[]
  categoryRevisionsCreated GeneralVoiceCategoryRevision[] @relation("CategoryRevisionCreator")
  categoryRoutesCreated    GeneralVoiceCategoryRoute[]    @relation("CategoryRouteCreator")
  categoriesCreated        GeneralVoiceCategory[]         @relation("CategoryCreator")
  handoversSent            VoiceHandover[]                @relation("HandoverFromPic")
  handoversReceived        VoiceHandover[]                @relation("HandoverToPic")
  handoversInitiated       VoiceHandover[]                @relation("HandoverActor")
  adminHandoversRequested  AdminHandover[]                @relation("AdminHandoverManager")
  adminHandoversOwned      AdminHandover[]                @relation("AdminHandoverAdmin")
  adminHandoversResolved   AdminHandover[]                @relation("AdminHandoverResolver")

  awayPeriods       AwayPeriod[] @relation("AwayAccount")
  awaySubstitutions AwayPeriod[] @relation("AwaySubstitute")

  @@index([accountKind, status])
  @@index([username, displayName])
  @@index([createdAt, id])
}

model AiProviderConfiguration {
  id                  String      @id @db.VarChar(40)
  baseUrl             String
  model               String      @db.VarChar(200)
  reasoningEffort     String      @db.VarChar(20)
  confidenceThreshold Float
  apiKeyCiphertext    String
  apiKeyIv            String      @db.VarChar(32)
  apiKeyTag           String      @db.VarChar(32)
  version             Int         @default(1)
  updatedById         String      @db.Uuid
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  updatedBy           UserAccount @relation(fields: [updatedById], references: [id])

  @@index([updatedById])
}

model Session {
  id                 String      @id @default(uuid()) @db.Uuid
  accountId          String      @db.Uuid
  tokenHash          String      @unique @db.Char(64)
  csrfSecret         String      @db.Char(64)
  ipHash             String?     @db.Char(64)
  userAgent          String?     @db.VarChar(300)
  passwordRestricted Boolean     @default(false)
  lastSeenAt         DateTime    @default(now())
  expiresAt          DateTime
  absoluteExpiresAt  DateTime
  revokedAt          DateTime?
  createdAt          DateTime    @default(now())
  account            UserAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

model OrganizationSnapshot {
  id           String                     @id @default(uuid()) @db.Uuid
  status       OrganizationSnapshotStatus
  checksum     String                     @db.Char(64)
  effectiveAt  DateTime                   @default(now())
  supersededAt DateTime?
  rowCount     Int
  createdAt    DateTime                   @default(now())
  memberships  OrganizationMembership[]
  importBatch  ImportBatch?
  voices       Voice[]                    @relation("VoiceOrganizationSnapshot")
  drafts       VoiceDraft[]               @relation("DraftOrganizationSnapshot")

  @@index([status, effectiveAt])
}

model OrganizationUnit {
  id             String                      @id @default(uuid()) @db.Uuid
  directorate    String                      @db.VarChar(200)
  division       String                      @db.VarChar(200)
  department     String                      @db.VarChar(200)
  createdAt      DateTime                    @default(now())
  memberships    OrganizationMembership[]
  routeMappings  RouteMapping[]
  voices         Voice[]                     @relation("VoiceOrganizationUnit")
  drafts         VoiceDraft[]                @relation("DraftOrganizationUnit")
  importIssues   ImportIssue[]
  categoryRoutes GeneralVoiceCategoryRoute[]
  shopLocation   ShopLocation?

  @@unique([directorate, division, department])
  @@index([division, department])
  @@index([createdAt, id])
}

model GeneralVoiceCategory {
  id                String                         @id @default(uuid()) @db.Uuid
  key               String                         @unique @db.VarChar(80)
  status            GeneralVoiceCategoryStatus     @default(ACTIVE)
  version           Int                            @default(1)
  createdById       String?                        @db.Uuid
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  archivedAt        DateTime?
  /// Bottom-up routing (Group Leader → Section Head → Manager → Division), ADR-0059.
  tiered            Boolean                        @default(false)
  createdBy         UserAccount?                   @relation("CategoryCreator", fields: [createdById], references: [id])
  revisions         GeneralVoiceCategoryRevision[]
  routes            GeneralVoiceCategoryRoute[]
  voices            Voice[]
  currentVoices     Voice[]                        @relation("VoiceCurrentCategory")
  classifications   AIClassification[]
  remediationIssues ImportIssue[]

  @@index([status, key])
}

model GeneralVoiceCategoryRevision {
  id              String               @id @default(uuid()) @db.Uuid
  categoryId      String               @db.Uuid
  revision        Int
  name            String               @db.VarChar(160)
  definition      String               @db.VarChar(4000)
  examples        Json
  effectiveFrom   DateTime             @default(now())
  effectiveTo     DateTime?
  createdById     String?              @db.Uuid
  category        GeneralVoiceCategory @relation(fields: [categoryId], references: [id])
  createdBy       UserAccount?         @relation("CategoryRevisionCreator", fields: [createdById], references: [id])
  classifications AIClassification[]

  @@unique([categoryId, revision])
  @@index([categoryId, effectiveTo])
}

model GeneralVoiceCategoryRoute {
  id                 String                        @id @default(uuid()) @db.Uuid
  categoryId         String                        @db.Uuid
  mode               GeneralVoiceCategoryRouteMode
  organizationUnitId String?                       @db.Uuid
  effectiveFrom      DateTime                      @default(now())
  effectiveTo        DateTime?
  createdById        String?                       @db.Uuid
  category           GeneralVoiceCategory          @relation(fields: [categoryId], references: [id])
  organizationUnit   OrganizationUnit?             @relation(fields: [organizationUnitId], references: [id])
  createdBy          UserAccount?                  @relation("CategoryRouteCreator", fields: [createdById], references: [id])

  @@index([categoryId, effectiveTo])
  @@index([organizationUnitId, effectiveTo])
}

// A production department (shop) and the plant areas where it operates. General
// Voices whose category routes by location owner are sent to this department.
model ShopLocation {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationUnitId String             @unique @db.Uuid
  areas              Area[]
  aliases            String[]
  status             ShopLocationStatus @default(ACTIVE)
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organizationUnit   OrganizationUnit   @relation(fields: [organizationUnitId], references: [id])
  voices             Voice[]

  @@index([status])
}

// Working calendar used by escalation deadlines. With useStandard, Monday-Friday
// are working days and exceptions are ignored.
model WorkingCalendarSetting {
  id          String   @id @db.VarChar(40)
  useStandard Boolean  @default(true)
  version     Int      @default(1)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model WorkingCalendarException {
  id          String          @id @default(uuid()) @db.Uuid
  date        DateTime        @unique @db.Date
  kind        CalendarDayKind
  label       String          @db.VarChar(120)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
}

// Respond/process window per severity, applied at every tier.
model EscalationDeadline {
  severity      Severity           @id
  respondAmount Int
  processAmount Int
  unit          EscalationTimeUnit
  version       Int                @default(1)
  updatedById   String?            @db.Uuid
  updatedAt     DateTime           @updatedAt
}

model OrganizationMembership {
  id                 String               @id @default(uuid()) @db.Uuid
  snapshotId         String               @db.Uuid
  employeeId         String               @db.Uuid
  organizationUnitId String               @db.Uuid
  employeeName       String               @db.VarChar(200)
  structuralPosition String               @db.VarChar(200)
  section            String               @db.VarChar(200)
  // Optional organization columns: an empty line means no Group Leader (line leader).
  lineName           String?              @db.VarChar(200)
  area               Area?
  sourceRow          Int
  snapshot           OrganizationSnapshot @relation(fields: [snapshotId], references: [id])
  employee           Employee             @relation(fields: [employeeId], references: [id])
  organizationUnit   OrganizationUnit     @relation(fields: [organizationUnitId], references: [id])

  @@unique([snapshotId, employeeId])
  @@index([employeeId, snapshotId])
  @@index([organizationUnitId, structuralPosition, snapshotId])
}

model RouteMapping {
  id                 String            @id @default(uuid()) @db.Uuid
  kind               RouteKind
  organizationUnitId String?           @db.Uuid
  ownerAccountId     String            @db.Uuid
  effectiveFrom      DateTime          @default(now())
  effectiveTo        DateTime?
  createdById        String?           @db.Uuid
  reason             String?           @db.VarChar(500)
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  owner              UserAccount       @relation("RouteOwner", fields: [ownerAccountId], references: [id])
  voices             Voice[]

  @@index([kind, effectiveTo])
  @@index([organizationUnitId, effectiveTo])
  @@index([ownerAccountId, effectiveTo])
}

model UnionAccountTerm {
  id            String      @id @default(uuid()) @db.Uuid
  accountId     String      @db.Uuid
  slot          UnionSlot
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  account       UserAccount @relation(fields: [accountId], references: [id])

  @@index([slot, effectiveTo])
  @@index([accountId, effectiveTo])
}

model ImportBatch {
  id             String                @id @default(uuid()) @db.Uuid
  status         ImportStatus          @default(PREVIEWED)
  checksum       String                @db.Char(64)
  storageKey     String
  summary        Json
  errors         Json
  baseSnapshotId String?               @db.Uuid
  snapshotId     String?               @unique @db.Uuid
  failureCode    String?               @db.VarChar(100)
  version        Int                   @default(1)
  expiresAt      DateTime
  confirmedAt    DateTime?
  actorId        String                @db.Uuid
  createdAt      DateTime              @default(now())
  actor          UserAccount           @relation(fields: [actorId], references: [id])
  snapshot       OrganizationSnapshot? @relation(fields: [snapshotId], references: [id])
  issues         ImportIssue[]
  changes        ImportChange[]

  @@index([status, expiresAt])
  @@index([createdAt, id])
}

model ImportChange {
  id        String      @id @default(uuid()) @db.Uuid
  batchId   String      @db.Uuid
  sequence  Int
  type      String      @db.VarChar(20)
  noReg     String      @db.VarChar(64)
  payload   Json
  createdAt DateTime    @default(now())
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, sequence])
  @@index([batchId, type, sequence, id])
}

model ImportIssue {
  id                 String                  @id @default(uuid()) @db.Uuid
  batchId            String                  @db.Uuid
  categoryId         String?                 @db.Uuid
  type               ImportIssueType
  status             ImportIssueStatus       @default(OPEN)
  organizationUnitId String?                 @db.Uuid
  accountId          String?                 @db.Uuid
  details            Json
  createdAt          DateTime                @default(now())
  resolvedAt         DateTime?
  batch              ImportBatch             @relation(fields: [batchId], references: [id])
  category           GeneralVoiceCategory?   @relation(fields: [categoryId], references: [id])
  organizationUnit   OrganizationUnit?       @relation(fields: [organizationUnitId], references: [id])
  resolutions        ImportIssueResolution[]

  @@index([status, type, createdAt])
  @@index([batchId, status])
}

model ImportIssueResolution {
  id        String      @id @default(uuid()) @db.Uuid
  issueId   String      @db.Uuid
  actorId   String      @db.Uuid
  action    String      @db.VarChar(100)
  reason    String      @db.VarChar(500)
  details   Json
  createdAt DateTime    @default(now())
  issue     ImportIssue @relation(fields: [issueId], references: [id])

  @@index([issueId, createdAt])
}

model RequestThrottle {
  keyHash     String   @id @db.Char(64)
  bucket      String   @db.VarChar(40)
  count       Int
  windowStart DateTime
  expiresAt   DateTime
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  scope       String   @db.VarChar(100)
  key         String   @db.VarChar(100)
  requestHash String   @db.Char(64)
  statusCode  Int
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([accountId, scope, key])
  @@index([expiresAt])
}

model VoiceDraft {
  id                        String                  @id @default(uuid()) @db.Uuid
  reporterId                String                  @db.Uuid
  area                      Area
  locationDetail            String                  @db.VarChar(200)
  title                     String                  @db.VarChar(150)
  detail                    String                  @db.VarChar(5000)
  visibility                VoiceVisibility
  organizationSnapshotId    String?                 @db.Uuid
  organizationUnitId        String?                 @db.Uuid
  privateContactConsent     Boolean?
  showReporterIdentity      Boolean?
  shopConfirmation          ShopConfirmation?
  confirmedShopLocationId   String?                 @db.Uuid
  /// TM (vocational) reporters pick where they work now; a null line means "Tidak di Line".
  positionSection           String?                 @db.VarChar(200)
  positionLine              String?                 @db.VarChar(200)
  classificationContentHash String                  @db.Char(64)
  locationContentHash       String                  @db.Char(64)
  version                   Int                     @default(1)
  expiresAt                 DateTime
  submittedAt               DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  reporter                  UserAccount             @relation("DraftReporter", fields: [reporterId], references: [id])
  organizationSnapshot      OrganizationSnapshot?   @relation("DraftOrganizationSnapshot", fields: [organizationSnapshotId], references: [id])
  organizationUnit          OrganizationUnit?       @relation("DraftOrganizationUnit", fields: [organizationUnitId], references: [id])
  classification            AIClassification?
  locationReview            LocationReviewSnapshot?
  attachments               Attachment[]

  @@index([reporterId, updatedAt])
  @@index([expiresAt])
}

model Voice {
  id                              String                  @id @default(uuid()) @db.Uuid
  displayId                       String                  @unique @db.VarChar(30)
  reporterId                      String                  @db.Uuid
  visibility                      VoiceVisibility
  area                            Area
  reporterOrganizationSnapshotId  String?                 @db.Uuid
  reporterOrganizationUnitId      String?                 @db.Uuid
  reporterNoRegSnapshot           String                  @db.VarChar(64)
  reporterNameSnapshot            String                  @db.VarChar(200)
  reporterDirectorateSnapshot     String?                 @db.VarChar(200)
  reporterDivisionSnapshot        String                  @db.VarChar(200)
  reporterDepartmentSnapshot      String                  @db.VarChar(200)
  reporterSectionSnapshot         String?                 @db.VarChar(200)
  reporterPositionSnapshot        String?                 @db.VarChar(200)
  reporterLineSnapshot            String?                 @db.VarChar(200)
  reporterAreaSnapshot            Area?
  /// Tiered categories only: the level holding the Voice, the levels found at
  /// submit, and who may act now. Null level means the classic route.
  tierLevel                       TierLevel?
  tierPath                        TierLevel[]             @default([])
  tierHolderIds                   String[]                @default([]) @db.Uuid
  /// Holders who answered before the Voice went up; the upper tier reminds them.
  tierLowerHolderIds              String[]                @default([]) @db.Uuid
  /// Former holders keep a read-only view after an unanswered Voice moved up.
  tierObserverIds                 String[]                @default([]) @db.Uuid
  /// Holders who raised the Voice by hand stay in the chat (messages only).
  tierParticipantIds              String[]                @default([]) @db.Uuid
  /// The reporter's Section has a Group Leader the Section Head may assign.
  sectionHasGroupLeader           Boolean                 @default(false)
  /// Fasilitas Kerja reported from another department's shop.
  outsideReporter                 Boolean                 @default(false)
  handlingOrganizationUnitId      String?                 @db.Uuid
  handlingDirectorateSnapshot     String?                 @db.VarChar(200)
  handlingDivisionSnapshot        String?                 @db.VarChar(200)
  handlingDepartmentSnapshot      String?                 @db.VarChar(200)
  handlingSectionSnapshot         String?                 @db.VarChar(200)
  handlingOrganizationSource      String                  @default("UNKNOWN") @db.VarChar(32)
  privateContactConsent           Boolean?
  privateContactConsentRecordedAt DateTime?
  privateContactConsentVersion    String?                 @db.VarChar(16)
  showReporterIdentity            Boolean?
  locationDetail                  String                  @db.VarChar(200)
  title                           String                  @db.VarChar(150)
  detail                          String                  @db.VarChar(5000)
  categoryLegacy                  RoutingCategory?        @map("category")
  categoryKey                     String?                 @db.VarChar(80)
  categoryId                      String?                 @db.Uuid
  categoryNameSnapshot            String?                 @db.VarChar(160)
  currentCategoryKey              String?                 @db.VarChar(80)
  currentCategoryId               String?                 @db.Uuid
  currentCategoryNameSnapshot     String?                 @db.VarChar(160)
  severity                        Severity
  status                          VoiceStatus             @default(OPEN)
  routeOwnerId                    String                  @db.Uuid
  routeMappingId                  String?                 @db.Uuid
  currentHandlerId                String?                 @db.Uuid
  handlerType                     HandlerType
  anonymousAlias                  String                  @db.VarChar(80)
  locationWarningAcknowledgedAt   DateTime?
  shopLocationId                  String?                 @db.Uuid
  shopOrganizationUnitId          String?                 @db.Uuid
  shopDepartmentSnapshot          String?                 @db.VarChar(200)
  shopResolutionSource            ShopResolutionSource?
  version                         Int                     @default(1)
  submittedAt                     DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  reporter                        UserAccount             @relation("VoiceReporter", fields: [reporterId], references: [id])
  routeOwner                      UserAccount             @relation("VoiceRouteOwner", fields: [routeOwnerId], references: [id])
  currentHandler                  UserAccount?            @relation("VoiceHandler", fields: [currentHandlerId], references: [id])
  reporterOrganizationSnapshot    OrganizationSnapshot?   @relation("VoiceOrganizationSnapshot", fields: [reporterOrganizationSnapshotId], references: [id])
  reporterOrganizationUnit        OrganizationUnit?       @relation("VoiceOrganizationUnit", fields: [reporterOrganizationUnitId], references: [id])
  routeMapping                    RouteMapping?           @relation(fields: [routeMappingId], references: [id])
  categoryRecord                  GeneralVoiceCategory?   @relation(fields: [categoryId], references: [id])
  currentCategoryRecord           GeneralVoiceCategory?   @relation("VoiceCurrentCategory", fields: [currentCategoryId], references: [id])
  shopLocation                    ShopLocation?           @relation(fields: [shopLocationId], references: [id])
  classification                  AIClassification?
  locationReview                  LocationReviewSnapshot?
  attachments                     Attachment[]
  assignments                     VoiceAssignment[]
  events                          VoiceEvent[]
  conversation                    Conversation?
  closureCycles                   ClosureCycle[]
  handlingTargets                 VoiceHandlingTarget[]
  handlingCycleNumber             Int                     @default(1)
  notifications                   Notification[]
  legacyAccess                    LegacyVoiceAccess[]
  handovers                       VoiceHandover[]
  adminHandovers                  AdminHandover[]
  reminders                       VoiceReminder[]

  @@index([reporterId, status, updatedAt])
  @@index([routeOwnerId, status, severity, submittedAt])
  @@index([currentHandlerId, status, severity, submittedAt])
  @@index([visibility, status, severity, submittedAt])
  @@index([area, categoryKey, status], map: "Voice_area_categoryKey_status_idx")
  @@index([area, currentCategoryKey, status], map: "Voice_area_currentCategoryKey_status_idx")
  @@index([reporterOrganizationUnitId, visibility, status])
  @@index([tierHolderIds], type: Gin)
  @@index([tierObserverIds], type: Gin)
  @@index([tierParticipantIds], type: Gin)
  @@index([severity, submittedAt])
  @@index([title, displayId])
}

model HumanVoiceSequence {
  period String @id @db.Char(6)
  value  Int
}

model AIClassification {
  id                     String                        @id @default(uuid()) @db.Uuid
  draftId                String?                       @unique @db.Uuid
  voiceId                String?                       @unique @db.Uuid
  model                  String                        @db.VarChar(100)
  promptVersion          String                        @db.VarChar(40)
  source                 ClassificationSource
  categoryLegacy         RoutingCategory?              @map("category")
  categoryKey            String?                       @db.VarChar(80)
  categoryId             String?                       @db.Uuid
  categoryRevisionId     String?                       @db.Uuid
  severity               Severity
  confidence             Float
  rationaleCode          String                        @db.VarChar(80)
  contentHash            String                        @db.Char(64)
  responseId             String?                       @db.VarChar(200)
  latencyMs              Int?
  inputTokens            Int?
  outputTokens           Int?
  fallbackCode           String?                       @db.VarChar(80)
  legacyProviderMetadata Json?
  createdAt              DateTime                      @default(now())
  draft                  VoiceDraft?                   @relation(fields: [draftId], references: [id])
  voice                  Voice?                        @relation(fields: [voiceId], references: [id])
  categoryRecord         GeneralVoiceCategory?         @relation(fields: [categoryId], references: [id])
  categoryRevision       GeneralVoiceCategoryRevision? @relation(fields: [categoryRevisionId], references: [id])
}

model LocationReviewSnapshot {
  id             String               @id @default(uuid()) @db.Uuid
  draftId        String?              @unique @db.Uuid
  voiceId        String?              @unique @db.Uuid
  model          String?              @db.VarChar(100)
  promptVersion  String               @db.VarChar(40)
  completeness   LocationCompleteness
  warning        String?              @db.VarChar(500)
  questions      Json
  contentHash    String               @db.Char(64)
  responseId     String?              @db.VarChar(200)
  latencyMs      Int?
  fallbackCode   String?              @db.VarChar(80)
  // Advisory AI shop suggestion from the area's active shop catalog.
  shopLocationId String?              @db.Uuid
  shopConfidence Float?
  createdAt      DateTime             @default(now())
  draft          VoiceDraft?          @relation(fields: [draftId], references: [id])
  voice          Voice?               @relation(fields: [voiceId], references: [id])
}

model Attachment {
  id         String            @id @default(uuid()) @db.Uuid
  draftId    String?           @db.Uuid
  voiceId    String?           @db.Uuid
  messageId  String?           @db.Uuid
  closureId  String?           @db.Uuid
  uploaderId String            @db.Uuid
  purpose    AttachmentPurpose
  state      AttachmentState   @default(STAGED)
  storageKey String            @unique
  mimeType   String            @db.VarChar(40)
  size       Int
  width      Int?
  height     Int?
  checksum   String            @db.Char(64)
  createdAt  DateTime          @default(now())
  readyAt    DateTime?
  draft      VoiceDraft?       @relation(fields: [draftId], references: [id])
  voice      Voice?            @relation(fields: [voiceId], references: [id])
  message    Message?          @relation(fields: [messageId], references: [id])
  closure    ClosureCycle?     @relation(fields: [closureId], references: [id])

  @@index([draftId, state])
  @@index([voiceId, purpose])
  @@index([state, createdAt])
}

model VoiceAssignment {
  id          String      @id @default(uuid()) @db.Uuid
  voiceId     String      @db.Uuid
  handlerId   String      @db.Uuid
  handlerType HandlerType
  actorId     String      @db.Uuid
  assignedAt  DateTime    @default(now())
  endedAt     DateTime?
  voice       Voice       @relation(fields: [voiceId], references: [id])
  handler     UserAccount @relation("AssignmentHandler", fields: [handlerId], references: [id])
  actor       UserAccount @relation("AssignmentActor", fields: [actorId], references: [id])

  @@index([voiceId, endedAt])
  @@index([handlerId, endedAt])
}

model VoiceHandover {
  id                       String                        @id @default(uuid()) @db.Uuid
  voiceId                  String                        @db.Uuid
  sequence                 Int
  fromCategoryId           String?                       @db.Uuid
  fromCategoryKey          String?                       @db.VarChar(80)
  fromCategoryNameSnapshot String?                       @db.VarChar(160)
  toCategoryId             String                        @db.Uuid
  toCategoryKey            String                        @db.VarChar(80)
  toCategoryNameSnapshot   String                        @db.VarChar(160)
  fromOrganizationUnitId   String?                       @db.Uuid
  fromDirectorateSnapshot  String?                       @db.VarChar(200)
  fromDivisionSnapshot     String?                       @db.VarChar(200)
  fromDepartmentSnapshot   String?                       @db.VarChar(200)
  toOrganizationUnitId     String                        @db.Uuid
  toDirectorateSnapshot    String                        @db.VarChar(200)
  toDivisionSnapshot       String                        @db.VarChar(200)
  toDepartmentSnapshot     String                        @db.VarChar(200)
  fromRouteMappingId       String?                       @db.Uuid
  toRouteMappingId         String                        @db.Uuid
  fromPicId                String                        @db.Uuid
  toPicId                  String                        @db.Uuid
  actorId                  String                        @db.Uuid
  routeMode                GeneralVoiceCategoryRouteMode
  isReporterDepartment     Boolean                       @default(false)
  detail                   String                        @db.VarChar(4000)
  createdAt                DateTime                      @default(now())
  voice                    Voice                         @relation(fields: [voiceId], references: [id])
  fromPic                  UserAccount                   @relation("HandoverFromPic", fields: [fromPicId], references: [id])
  toPic                    UserAccount                   @relation("HandoverToPic", fields: [toPicId], references: [id])
  actor                    UserAccount                   @relation("HandoverActor", fields: [actorId], references: [id])

  @@unique([voiceId, sequence])
  @@index([fromPicId, createdAt, id])
  @@index([toPicId, createdAt, id])
  @@index([voiceId, createdAt, id])
}

model AdminHandover {
  id                        String              @id @default(uuid()) @db.Uuid
  voiceId                   String              @db.Uuid
  managerId                 String              @db.Uuid
  adminId                   String              @db.Uuid
  status                    AdminHandoverStatus @default(PENDING)
  managerDetail             String              @db.VarChar(4000)
  adminDetail               String?             @db.VarChar(4000)
  sourceRouteMappingId      String?             @db.Uuid
  sourceOrganizationUnitId  String?             @db.Uuid
  destinationUnitId         String?             @db.Uuid
  destinationRouteMappingId String?             @db.Uuid
  destinationPicId          String?             @db.Uuid
  categoryId                String?             @db.Uuid
  categoryKey               String?             @db.VarChar(80)
  categoryNameSnapshot      String?             @db.VarChar(160)
  resolvedById              String?             @db.Uuid
  createdAt                 DateTime            @default(now())
  resolvedAt                DateTime?
  voice                     Voice               @relation(fields: [voiceId], references: [id])
  manager                   UserAccount         @relation("AdminHandoverManager", fields: [managerId], references: [id])
  admin                     UserAccount         @relation("AdminHandoverAdmin", fields: [adminId], references: [id])
  resolvedBy                UserAccount?        @relation("AdminHandoverResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt, id])
  @@index([voiceId, createdAt, id])
  @@index([managerId, createdAt, id])
}

model VoiceEvent {
  id                      String         @id @default(uuid()) @db.Uuid
  voiceId                 String         @db.Uuid
  type                    VoiceEventType
  actorId                 String         @db.Uuid
  actorAccountKind        AccountKind
  actorStructuralPosition String?        @db.VarChar(200)
  actorCapabilities       Json
  payload                 Json
  occurredAt              DateTime       @default(now())
  voice                   Voice          @relation(fields: [voiceId], references: [id])
  actor                   UserAccount    @relation(fields: [actorId], references: [id])

  @@index([voiceId, occurredAt, id])
}

model Conversation {
  id         String                  @id @default(uuid()) @db.Uuid
  voiceId    String                  @unique @db.Uuid
  createdAt  DateTime                @default(now())
  voice      Voice                   @relation(fields: [voiceId], references: [id])
  messages   Message[]
  readStates ConversationReadState[]
}

// Last time a participant opened the conversation; drives unread badges.
/// "Sedang tidak masuk": while active (WIB days, inclusive) the substitute acts
/// for the account; "Aktif kembali" ends it early.
model AwayPeriod {
  id           String      @id @default(uuid()) @db.Uuid
  accountId    String      @db.Uuid
  substituteId String      @db.Uuid
  startsOn     DateTime    @db.Date
  endsOn       DateTime    @db.Date
  endedAt      DateTime?
  createdAt    DateTime    @default(now())
  account      UserAccount @relation("AwayAccount", fields: [accountId], references: [id])
  substitute   UserAccount @relation("AwaySubstitute", fields: [substituteId], references: [id])

  @@index([accountId, endedAt, endsOn])
  @@index([substituteId, endedAt, endsOn])
}

/// Ingatkan: at most one reminder per actor, target and WIB day for a Voice.
model VoiceReminder {
  id        String   @id @default(uuid()) @db.Uuid
  voiceId   String   @db.Uuid
  actorId   String   @db.Uuid
  targetId  String   @db.Uuid
  dayKey    String   @db.VarChar(10)
  createdAt DateTime @default(now())
  voice     Voice    @relation(fields: [voiceId], references: [id])

  @@unique([voiceId, actorId, targetId, dayKey])
}

model ConversationReadState {
  conversationId String       @db.Uuid
  accountId      String       @db.Uuid
  lastReadAt     DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@id([conversationId, accountId])
}

model Message {
  id                       String       @id @default(uuid()) @db.Uuid
  conversationId           String       @db.Uuid
  senderId                 String       @db.Uuid
  senderAccountKind        AccountKind
  senderStructuralPosition String?      @db.VarChar(200)
  senderCapabilities       Json
  senderNameSnapshot       String?      @db.VarChar(200)
  text                     String?      @db.VarChar(4000)
  /// SYSTEM marks lifecycle notes posted into the chat (handover, reminders).
  kind                     MessageKind  @default(USER)
  createdAt                DateTime     @default(now())
  conversation             Conversation @relation(fields: [conversationId], references: [id])
  sender                   UserAccount  @relation(fields: [senderId], references: [id])
  attachments              Attachment[]

  @@index([conversationId, createdAt, id])
}

model ClosureCycle {
  id               String             @id @default(uuid()) @db.Uuid
  voiceId          String             @db.Uuid
  cycleNumber      Int
  actorId          String             @db.Uuid
  note             String             @db.VarChar(4000)
  closedAt         DateTime           @default(now())
  reopenedAt       DateTime?
  reviewState      ClosureReviewState @default(PENDING)
  reviewDeadline   DateTime?
  reviewResolvedAt DateTime?
  voice            Voice              @relation(fields: [voiceId], references: [id])
  actor            UserAccount        @relation(fields: [actorId], references: [id])
  evidence         Attachment[]
  rating           Rating?

  @@unique([voiceId, cycleNumber])
  @@index([voiceId, closedAt])
  @@index([reviewState, reviewDeadline])
}

model Rating {
  id             String       @id @default(uuid()) @db.Uuid
  closureCycleId String       @unique @db.Uuid
  reporterId     String       @db.Uuid
  score          Int
  feedback       String?      @db.VarChar(2000)
  reopen         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  closureCycle   ClosureCycle @relation(fields: [closureCycleId], references: [id])
  reporter       UserAccount  @relation(fields: [reporterId], references: [id])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @db.Uuid
  voiceId     String?          @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(200)
  body        String           @db.VarChar(500)
  deepLink    String?          @db.VarChar(300)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   UserAccount      @relation(fields: [recipientId], references: [id])
  voice       Voice?           @relation(fields: [voiceId], references: [id])

  @@index([recipientId, readAt, createdAt])
}

model PushSubscription {
  id             String      @id @default(uuid()) @db.Uuid
  accountId      String      @db.Uuid
  sessionId      String      @db.Uuid
  installationId String      @db.VarChar(100)
  endpoint       String
  endpointHash   String      @db.Char(64)
  p256dh         String
  auth           String
  environment    String      @db.VarChar(30)
  active         Boolean     @default(true)
  failureCount   Int         @default(0)
  lastSuccessAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  account        UserAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, installationId, environment])
  @@unique([endpointHash, environment])
  @@index([endpointHash, active])
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  topic       String       @db.VarChar(80)
  dedupeKey   String       @unique @db.VarChar(200)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  lastError   String?      @db.VarChar(200)
  deliveredAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

model AuditEvent {
  id                      String       @id @default(uuid()) @db.Uuid
  actorId                 String?      @db.Uuid
  actorAccountKind        AccountKind?
  actorStructuralPosition String?      @db.VarChar(200)
  actorCapabilities       Json?
  action                  String       @db.VarChar(100)
  result                  String       @db.VarChar(40)
  resourceType            String       @db.VarChar(80)
  resourceId              String?      @db.VarChar(100)
  summary                 Json
  reason                  String?      @db.VarChar(500)
  correlationId           String       @db.VarChar(100)
  ipHash                  String?      @db.Char(64)
  userAgent               String?      @db.VarChar(300)
  sessionRef              String?      @db.Char(64)
  releaseSha              String       @db.VarChar(80)
  occurredAt              DateTime     @default(now())
  actor                   UserAccount? @relation(fields: [actorId], references: [id])

  @@index([occurredAt, id])
  @@index([resourceType, resourceId, occurredAt])
  @@index([action, result, actorAccountKind, occurredAt, id])
  @@index([correlationId, occurredAt])
}

model LegacyVoiceAccess {
  id            String      @id @default(uuid()) @db.Uuid
  voiceId       String      @db.Uuid
  accountId     String      @db.Uuid
  reason        String      @db.VarChar(100)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  voice         Voice       @relation(fields: [voiceId], references: [id])
  account       UserAccount @relation(fields: [accountId], references: [id])

  @@unique([voiceId, accountId])
  @@index([accountId, effectiveTo])
}

model VoiceHandlingTarget {
  id                String    @id @default(uuid()) @db.Uuid
  voiceId           String    @db.Uuid
  cycleNumber       Int
  days              Int
  setById           String    @db.Uuid
  setAt             DateTime  @default(now())
  dueAt             DateTime
  /// 08:00 WIB on the target day; skipped for same-day targets.
  reminderSentAt    DateTime?
  overdueNotifiedAt DateTime?
  voice             Voice     @relation(fields: [voiceId], references: [id])

  @@unique([voiceId, cycleNumber])
  @@index([overdueNotifiedAt, dueAt])
  @@index([reminderSentAt, dueAt])
}

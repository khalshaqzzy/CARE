generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CARE_ADMIN
  MEMBER
  MANAGER
  SECTION_HEAD
  UNION
}

enum Area {
  KARAWANG_1
  KARAWANG_2
  KARAWANG_3
  SUNTER_1
  SUNTER_2
}

enum VoiceVisibility {
  PRIVATE
  GENERAL
}
enum RoutingCategory {
  SAFETY
  FACILITY
  WORK_DIFFICULTY
}
enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum VoiceStatus {
  OPEN
  IN_VERIFICATION
  IN_PROGRESS
  CLOSED
}
enum HandlerType {
  MANAGER
  SECTION_HEAD
  UNION
}
enum ClassificationSource {
  AI
  MANUAL_FALLBACK
}
enum AttachmentPurpose {
  VOICE
  CHAT
  CLOSURE_EVIDENCE
}
enum AttachmentState {
  STAGED
  PROCESSED
  REFERENCED
  READY
  ORPHANED
}
enum ImportType {
  EMPLOYEE
  MANAGER
  UNION
}
enum ImportStatus {
  PREVIEWED
  CONFIRMED
  FAILED
  EXPIRED
}
enum VoiceEventType {
  SUBMITTED
  ASKED_REPORTER
  MESSAGE_SENT
  ASSIGNED
  REASSIGNED
  PROCEEDED
  CLOSED
  RATED
  REOPENED
}
enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD_LETTER
}
enum NotificationType {
  VOICE_SUBMITTED
  ASSIGNED
  MESSAGE
  STATUS_CHANGED
  CLOSED
  RATED
  REOPENED
  SECURITY
}

model Employee {
  id           String   @id @default(uuid()) @db.Uuid
  noReg        String   @unique @db.VarChar(64)
  name         String   @db.VarChar(200)
  division     String   @db.VarChar(200)
  department   String   @db.VarChar(200)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      UserAccount?
  manager      ManagerProfile?
  sectionHeads SectionHeadRelation[] @relation("SectionHeadEmployee")
}

model UserAccount {
  id                     String   @id @default(uuid()) @db.Uuid
  employeeId             String?  @unique @db.Uuid
  username               String   @unique @db.VarChar(64)
  displayName            String   @db.VarChar(200)
  passwordHash           String
  role                   Role
  active                 Boolean  @default(true)
  passwordChangeRequired Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  employee               Employee? @relation(fields: [employeeId], references: [id])
  managerProfile         ManagerProfile?
  sessions               Session[]
  drafts                 VoiceDraft[] @relation("DraftReporter")
  reportedVoices         Voice[] @relation("VoiceReporter")
  routedVoices           Voice[] @relation("VoiceRouteOwner")
  handledVoices          Voice[] @relation("VoiceHandler")
  messages               Message[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  auditEvents            AuditEvent[]
  importBatches          ImportBatch[]
  assignedRelations      SectionHeadRelation[] @relation("ManagerAccount")
  assignmentsMade        VoiceAssignment[] @relation("AssignmentActor")
  assignmentsReceived    VoiceAssignment[] @relation("AssignmentHandler")
  events                 VoiceEvent[]
  closureCycles          ClosureCycle[]
  ratings                Rating[]

  @@index([role, active])
}

model ManagerProfile {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @unique @db.Uuid
  accountId  String   @unique @db.Uuid
  area       Area
  department String   @db.VarChar(200)
  isSafety   Boolean  @default(false)
  isFacility Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
  account    UserAccount @relation(fields: [accountId], references: [id])

  @@index([area, active])
  @@index([department, active])
}

model SectionHeadRelation {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  managerId     String   @db.Uuid
  active        Boolean  @default(true)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  employee      Employee @relation("SectionHeadEmployee", fields: [employeeId], references: [id])
  manager       UserAccount @relation("ManagerAccount", fields: [managerId], references: [id])

  @@index([employeeId, active])
  @@index([managerId, active])
}

model Session {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @db.Uuid
  tokenHash         String   @unique @db.Char(64)
  csrfSecret        String   @db.Char(64)
  ipHash            String?  @db.Char(64)
  userAgent         String?  @db.VarChar(300)
  passwordRestricted Boolean @default(false)
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  createdAt         DateTime @default(now())
  account           UserAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  type        ImportType
  status      ImportStatus @default(PREVIEWED)
  checksum    String       @db.Char(64)
  storageKey  String
  summary     Json
  errors      Json
  version     Int          @default(1)
  expiresAt   DateTime
  confirmedAt DateTime?
  actorId     String       @db.Uuid
  createdAt   DateTime     @default(now())
  actor       UserAccount  @relation(fields: [actorId], references: [id])

  @@index([status, expiresAt])
}

model RequestThrottle {
  keyHash     String   @id @db.Char(64)
  bucket      String   @db.VarChar(40)
  count       Int
  windowStart DateTime
  expiresAt   DateTime
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  scope       String   @db.VarChar(100)
  key         String   @db.VarChar(100)
  requestHash String   @db.Char(64)
  statusCode  Int
  response    Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([accountId, scope, key])
  @@index([expiresAt])
}

model VoiceDraft {
  id                String          @id @default(uuid()) @db.Uuid
  reporterId        String          @db.Uuid
  area              Area
  locationDetail    String          @db.VarChar(200)
  title             String          @db.VarChar(150)
  detail            String          @db.VarChar(5000)
  visibility        VoiceVisibility
  reporterDepartment String         @db.VarChar(200)
  contentHash       String          @db.Char(64)
  version           Int             @default(1)
  expiresAt         DateTime
  submittedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  reporter          UserAccount     @relation("DraftReporter", fields: [reporterId], references: [id])
  classification    AIClassification?
  attachments       Attachment[]

  @@index([reporterId, updatedAt])
  @@index([expiresAt])
}

model Voice {
  id                 String          @id @default(uuid()) @db.Uuid
  displayId          String          @unique @db.VarChar(30)
  reporterId         String          @db.Uuid
  visibility         VoiceVisibility
  area               Area
  reporterDepartment String          @db.VarChar(200)
  locationDetail     String          @db.VarChar(200)
  title              String          @db.VarChar(150)
  detail             String          @db.VarChar(5000)
  category           RoutingCategory?
  severity           Severity
  status             VoiceStatus     @default(OPEN)
  routeOwnerId       String          @db.Uuid
  currentHandlerId   String?         @db.Uuid
  handlerType        HandlerType
  anonymousAlias     String          @db.VarChar(80)
  version            Int             @default(1)
  submittedAt        DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  reporter           UserAccount     @relation("VoiceReporter", fields: [reporterId], references: [id])
  routeOwner         UserAccount     @relation("VoiceRouteOwner", fields: [routeOwnerId], references: [id])
  currentHandler     UserAccount?    @relation("VoiceHandler", fields: [currentHandlerId], references: [id])
  classification     AIClassification?
  attachments        Attachment[]
  assignments        VoiceAssignment[]
  events             VoiceEvent[]
  conversation       Conversation?
  closureCycles      ClosureCycle[]
  notifications      Notification[]

  @@index([reporterId, status, updatedAt])
  @@index([routeOwnerId, status, severity, submittedAt])
  @@index([currentHandlerId, status, severity, submittedAt])
  @@index([visibility, status, severity, submittedAt])
  @@index([area, category, status])
}

model HumanVoiceSequence {
  period String @id @db.Char(6)
  value  Int
}

model AIClassification {
  id            String               @id @default(uuid()) @db.Uuid
  draftId       String?              @unique @db.Uuid
  voiceId       String?              @unique @db.Uuid
  model         String               @db.VarChar(100)
  location      String               @db.VarChar(40)
  promptVersion String               @db.VarChar(40)
  source        ClassificationSource
  category      RoutingCategory
  severity      Severity
  confidence    Float
  rationaleCode String               @db.VarChar(80)
  contentHash   String               @db.Char(64)
  responseId    String?              @db.VarChar(200)
  latencyMs     Int?
  inputTokens   Int?
  outputTokens  Int?
  fallbackCode  String?              @db.VarChar(80)
  createdAt     DateTime             @default(now())
  draft         VoiceDraft?          @relation(fields: [draftId], references: [id])
  voice         Voice?               @relation(fields: [voiceId], references: [id])
}

model Attachment {
  id          String            @id @default(uuid()) @db.Uuid
  draftId     String?           @db.Uuid
  voiceId     String?           @db.Uuid
  messageId   String?           @db.Uuid
  closureId   String?           @db.Uuid
  uploaderId  String            @db.Uuid
  purpose     AttachmentPurpose
  state       AttachmentState   @default(STAGED)
  storageKey  String            @unique
  mimeType    String            @db.VarChar(40)
  size        Int
  width       Int?
  height      Int?
  checksum    String            @db.Char(64)
  createdAt   DateTime          @default(now())
  readyAt     DateTime?
  draft       VoiceDraft?       @relation(fields: [draftId], references: [id])
  voice       Voice?            @relation(fields: [voiceId], references: [id])
  message     Message?          @relation(fields: [messageId], references: [id])
  closure     ClosureCycle?     @relation(fields: [closureId], references: [id])

  @@index([draftId, state])
  @@index([voiceId, purpose])
  @@index([state, createdAt])
}

model VoiceAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  voiceId       String      @db.Uuid
  handlerId     String      @db.Uuid
  handlerType   HandlerType
  actorId       String      @db.Uuid
  assignedAt    DateTime    @default(now())
  endedAt       DateTime?
  voice         Voice       @relation(fields: [voiceId], references: [id])
  handler       UserAccount @relation("AssignmentHandler", fields: [handlerId], references: [id])
  actor         UserAccount @relation("AssignmentActor", fields: [actorId], references: [id])

  @@index([voiceId, endedAt])
  @@index([handlerId, endedAt])
}

model VoiceEvent {
  id           String         @id @default(uuid()) @db.Uuid
  voiceId      String         @db.Uuid
  type         VoiceEventType
  actorId      String         @db.Uuid
  actorRole    Role
  payload      Json
  occurredAt   DateTime       @default(now())
  voice        Voice          @relation(fields: [voiceId], references: [id])
  actor        UserAccount    @relation(fields: [actorId], references: [id])

  @@index([voiceId, occurredAt, id])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  voiceId   String   @unique @db.Uuid
  createdAt DateTime @default(now())
  voice     Voice    @relation(fields: [voiceId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  senderRole     Role
  text           String?      @db.VarChar(4000)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         UserAccount  @relation(fields: [senderId], references: [id])
  attachments    Attachment[]

  @@index([conversationId, createdAt, id])
}

model ClosureCycle {
  id          String      @id @default(uuid()) @db.Uuid
  voiceId     String      @db.Uuid
  cycleNumber Int
  actorId     String      @db.Uuid
  note        String      @db.VarChar(4000)
  closedAt    DateTime    @default(now())
  reopenedAt  DateTime?
  voice       Voice       @relation(fields: [voiceId], references: [id])
  actor       UserAccount @relation(fields: [actorId], references: [id])
  evidence    Attachment[]
  rating      Rating?

  @@unique([voiceId, cycleNumber])
  @@index([voiceId, closedAt])
}

model Rating {
  id             String       @id @default(uuid()) @db.Uuid
  closureCycleId String       @unique @db.Uuid
  reporterId     String       @db.Uuid
  score          Int
  feedback       String?      @db.VarChar(2000)
  reopen         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  closureCycle   ClosureCycle @relation(fields: [closureCycleId], references: [id])
  reporter       UserAccount  @relation(fields: [reporterId], references: [id])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  recipientId String          @db.Uuid
  voiceId    String?          @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String           @db.VarChar(500)
  deepLink   String?          @db.VarChar(300)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  recipient  UserAccount      @relation(fields: [recipientId], references: [id])
  voice      Voice?           @relation(fields: [voiceId], references: [id])

  @@index([recipientId, readAt, createdAt])
}

model PushSubscription {
  id           String      @id @default(uuid()) @db.Uuid
  accountId    String      @db.Uuid
  sessionId    String      @db.Uuid
  installationId String    @db.VarChar(100)
  endpoint     String
  endpointHash String      @db.Char(64)
  p256dh       String
  auth         String
  environment  String      @db.VarChar(30)
  active       Boolean     @default(true)
  failureCount Int         @default(0)
  lastSuccessAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  account      UserAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, installationId, environment])
  @@unique([endpointHash, environment])
  @@index([endpointHash, active])
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  topic       String       @db.VarChar(80)
  dedupeKey   String       @unique @db.VarChar(200)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  lastError   String?      @db.VarChar(200)
  deliveredAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  actorId       String?     @db.Uuid
  actorRole     Role?
  action        String      @db.VarChar(100)
  result        String      @db.VarChar(40)
  resourceType  String      @db.VarChar(80)
  resourceId    String?     @db.VarChar(100)
  summary       Json
  reason        String?     @db.VarChar(500)
  correlationId String      @db.VarChar(100)
  ipHash        String?     @db.Char(64)
  userAgent     String?     @db.VarChar(300)
  sessionRef    String?     @db.Char(64)
  releaseSha    String      @db.VarChar(80)
  occurredAt    DateTime    @default(now())
  actor         UserAccount? @relation(fields: [actorId], references: [id])

  @@index([occurredAt, id])
  @@index([resourceType, resourceId, occurredAt])
}
